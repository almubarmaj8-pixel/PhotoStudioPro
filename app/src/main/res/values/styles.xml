<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AdjustLabel" parent="TextAppearance.Material3.BodySmall">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>
    <style name="AdjustSlider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:max">200</item>
        <item name="android:progress">100</item>
        <item name="android:progressTint">@color/purple_primary</item>
        <item name="android:progressBackgroundTint">@color/bg_dark_card</item>
        <item name="android:thumbTint">@color/pink_accent</item>
    </style>
    <style name="CropChip" parent="Widget.Material3.Chip.Filter">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="chipBackgroundColor">@color/bg_dark_card</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="chipStrokeColor">@color/purple_light</item>
        <item name="chipStrokeWidth">1dp</item>
    </style>
</resources>
